<?xml version="1.0"?>
<!--
  Gazebo (gz-sim 8, Harmonic) systems and sensors: differential drive, 2D LiDAR,
  3D LiDAR, IMU, wheel joint states and a ground truth pose publisher.

  Migrated from Gazebo Classic 11, which reached end of life in January 2025.
  Every sensor keeps its Classic rate, resolution, range and noise, and the
  drive keeps its geometry and limits, so the robot the stack sees is the same
  robot. What changed is the transport: gz-sim systems publish on gz-transport
  topics and ros_gz_bridge (amr_bringup/config/gz_bridge.yaml) carries them into
  ROS. Nothing in this file talks to ROS directly.

  Sensor noise is set deliberately, not left at zero. A noiseless simulation
  produces localisation numbers that cannot be reproduced on hardware and that
  make the whole evaluation misleading. The values here are representative of
  the class of hardware this stack targets and are the same values the synthetic
  point-cloud generator in amr_perception uses, so metrics measured offline
  describe the same problem as the simulated run.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ==================================================================== -->
  <!-- Differential drive                                                    -->
  <!-- ==================================================================== -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.50</wheel_separation>
      <wheel_radius>0.10</wheel_radius>

      <!-- Absolute topic names, so the bridge does not need to know the model
           name. cmd_vel arrives from Nav2's velocity smoother. -->
      <topic>/cmd_vel</topic>

      <!-- Odometry is integrated from the wheel joint positions, the way real
           encoders work, including through wheel slip. gz-sim's DiffDrive has
           no "world" source at all, which retires the Classic trap where
           odometry_source 1 silently published ground truth as odometry.

           It publishes on odom_raw rather than odom because gz.msgs.Odometry
           carries no covariance, so the bridged message has an all-zero
           matrix. robot_localization clamps a zero variance to 1e-9 and would
           then trust the wheels absolutely. amr_bringup's odom_covariance node
           stamps the covariance the Classic plugin advertised and republishes
           on /odom. -->
      <odom_topic>/odom_raw</odom_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>

      <!-- The EKF owns odom -> base_footprint. The system always publishes a
           transform, so it goes to a gz topic that nothing bridges; the effect
           is the Classic publish_odom_tf false. -->
      <tf_topic>/model/warehouse_amr/tf_unused</tf_topic>

      <!-- 1.0 m/s^2 at the contact patch, which is what acc_lim_x in
           nav2_params.yaml is set to. These two numbers must agree: a DWB that
           plans deceleration the base cannot deliver will overshoot every goal
           and clip every corner. Classic expressed this as 10 rad/s^2 of wheel
           acceleration at a 0.10 m radius, the same value.

           Angular: each wheel at 1.0 m/s^2 in opposite directions over a
           0.50 m track is 2 x 1.0 / 0.50 = 4.0 rad/s^2, which is the limit the
           Classic wheel-acceleration cap imposed on a spin. -->
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_linear_acceleration>-1.0</min_linear_acceleration>
      <max_angular_acceleration>4.0</max_angular_acceleration>
      <min_angular_acceleration>-4.0</min_angular_acceleration>
    </plugin>

    <!-- Wheel joint angles, so robot_state_publisher can place the wheel
         links. Classic's diff drive did this with publish_wheel_tf. Without
         update_rate it publishes on every 1 ms physics step, and the bridge
         and robot_state_publisher spend a core forwarding wheel angles. -->
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
      <update_rate>50</update_rate>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

  <!-- ==================================================================== -->
  <!-- 2D LiDAR: AMCL, Cartographer, scan odometry, Nav2 obstacle layer      -->
  <!--                                                                       -->
  <!-- gpu_lidar is the only LiDAR gz-sim has: it is rendered by ogre2, so a  -->
  <!-- headless run needs a GL implementation. In CI and Docker that is      -->
  <!-- Mesa's llvmpipe on the CPU; see docs/simulation.md.                   -->
  <!-- ==================================================================== -->
  <gazebo reference="lidar_2d_link">
    <sensor name="lidar_2d" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <!-- Without this the message is stamped with the scoped gz frame name,
           which is not in the TF tree, because sdformat folds fixed-joint
           links into their parent. -->
      <gz_frame_id>lidar_2d_link</gz_frame_id>
      <topic>/$(arg scan_topic)</topic>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>10.0</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <!-- 720 samples over the full circle: 0.5 degree resolution, which
                 resolves a 0.10 m racking upright out to about 11 m. -->
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.12</min>
          <max>25.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- ==================================================================== -->
  <!-- 3D LiDAR: segmentation and zone occupancy                             -->
  <!-- ==================================================================== -->
  <gazebo reference="lidar_3d_link">
    <sensor name="lidar_3d" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <gz_frame_id>lidar_3d_link</gz_frame_id>
      <!-- gpu_lidar publishes a LaserScan on <topic> and the point cloud on
           <topic>/points; the bridge carries only the cloud. -->
      <topic>/lidar_3d</topic>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>10.0</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <!-- 1800 x 0.2 degrees, the standard 10 Hz configuration for a
                 16-ring spinning unit. -->
            <samples>1800</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical>
            <!-- 16 rings over +-15 degrees. At 12 m the ring spacing on a
                 vertical surface is about 0.30 m, which is what sets the
                 clustering tolerance: below roughly 0.32 m a person at the far
                 end of the aisle fragments into one cluster per ring. -->
            <samples>16</samples>
            <resolution>1</resolution>
            <min_angle>-0.261799</min_angle>
            <max_angle>0.261799</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.60</min>
          <max>40.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- ==================================================================== -->
  <!-- IMU                                                                   -->
  <!-- ==================================================================== -->
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <gz_frame_id>imu_link</gz_frame_id>
      <topic>/imu/data</topic>
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <imu>
        <angular_velocity>
          <!-- 2e-4 rad/s noise with a 1e-5 rad/s bias random walk: the region a
               mid-range MEMS gyro occupies. Zero noise here would let the EKF
               integrate a perfect yaw rate and make the whole scan-matcher
               contribution look pointless. -->
          <x><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev>
             <bias_mean>0.0000075</bias_mean><bias_stddev>0.0000008</bias_stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev>
             <bias_mean>0.0000075</bias_mean><bias_stddev>0.0000008</bias_stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev>
             <bias_mean>0.0000075</bias_mean><bias_stddev>0.0000008</bias_stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev>
             <bias_mean>0.1</bias_mean><bias_stddev>0.001</bias_stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev>
             <bias_mean>0.1</bias_mean><bias_stddev>0.001</bias_stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev>
             <bias_mean>0.1</bias_mean><bias_stddev>0.001</bias_stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- ==================================================================== -->
  <!-- Ground truth                                                          -->
  <!--                                                                       -->
  <!-- Publishes the simulator's exact pose on /ground_truth/pose. This is the -->
  <!-- reference the localisation evaluation measures against, and it is the   -->
  <!-- ONLY consumer of it. Nothing in the navigation or localisation stack    -->
  <!-- subscribes to this topic; if anything did, the evaluation would be      -->
  <!-- measuring the simulator against itself. pose_logger checks that at      -->
  <!-- runtime. Replaces Classic's gazebo_ros_p3d.                             -->
  <!-- ==================================================================== -->
  <gazebo>
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_topic>/ground_truth/pose</odom_topic>
      <odom_covariance_topic>/ground_truth/pose_cov_unused</odom_covariance_topic>
      <tf_topic>/ground_truth/tf_unused</tf_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>
  </gazebo>

</robot>
