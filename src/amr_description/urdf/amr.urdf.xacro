<?xml version="1.0"?>
<!--
  Differential-drive warehouse AMR.

  Frame convention is REP-105 / REP-120: base_footprint is the robot's ground
  projection and is what AMCL and the perception pipeline work in; base_link is
  the body origin at the drive axle height. The segmentation node's ground-plane
  seed band is expressed relative to a floor at z = 0, so it must be given
  base_footprint and not base_link.

  Inertias are computed from the primitive formulae rather than guessed. Gazebo
  is perfectly willing to simulate a robot with a wrong inertia tensor, and what
  you get is a base that either refuses to turn or oscillates about yaw, which
  then looks exactly like a controller tuning problem and wastes a day.
-->
<robot name="warehouse_amr" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="use_gazebo" default="true"/>
  <!-- Where the 2D LiDAR publishes. Normally "scan", straight to the stack.
       The fault-injection run sets this to "scan_raw" and interposes
       amr_bringup's scan_relay, which can be told to go quiet to simulate a
       sensor dropout. Keeping it a parameter means every other run is wired
       exactly as it was measured, with no relay in the path. -->
  <xacro:arg name="scan_topic" default="scan"/>

  <!-- Body: 0.70 x 0.50 x 0.28 m chassis, 65 kg laden. -->
  <xacro:property name="base_length" value="0.70"/>
  <xacro:property name="base_width"  value="0.50"/>
  <xacro:property name="base_height" value="0.28"/>
  <xacro:property name="base_mass"   value="65.0"/>

  <!-- Drive wheels. 0.5 m track is the value the DWB velocity limits and the
       AMCL differential motion model are both derived from; changing it here
       without changing those makes the robot's actual turning behaviour differ
       from what the planner assumes. -->
  <xacro:property name="wheel_radius"    value="0.10"/>
  <xacro:property name="wheel_width"     value="0.05"/>
  <xacro:property name="wheel_mass"      value="2.0"/>
  <xacro:property name="wheel_separation" value="0.50"/>

  <xacro:property name="caster_radius" value="0.04"/>
  <xacro:property name="caster_mass"   value="0.5"/>

  <!-- Casters sit this far ABOVE the floor when the drive wheels are on it.
       3 mm, and it is the difference between a robot that drives and one that
       does not.

       Sized so both casters and both wheels bottom out at exactly z = 0 and the
       load split between them is numerically indeterminate. the contact solver resolves the
       stiff sphere-plane point contacts first, lifting the chassis by a
       hair, and the drive wheels end up carrying no normal force. They then
       spin at exactly the commanded rate — 3.000 rad/s for 0.3 m/s — while the
       robot sits still on two mu=0.02 casters. Every plugin reports success and
       nothing in any log is wrong.

       Lifting the casters puts the weight on the drive wheels, where it
       belongs. The robot pitches a fraction of a degree onto whichever caster
       is loaded, exactly as a real two-wheel-plus-caster AMR does. -->
  <xacro:property name="caster_clearance" value="0.003"/>

  <!-- Sensor mounting. The 2D LiDAR sits low and forward, at the height that
       sees pallet feet and the underside of a shelf beam. The 3D LiDAR sits on
       a mast so its rings sweep the full 2.2 m racking height. -->
  <xacro:property name="lidar_2d_height" value="0.35"/>
  <xacro:property name="lidar_3d_height" value="0.90"/>

  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12.0}" ixy="0.0" ixz="0.0"
               iyy="${m*(x*x+z*z)/12.0}" iyz="0.0"
               izz="${m*(x*x+y*y)/12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(3.0*r*r+h*h)/12.0}" ixy="0.0" ixz="0.0"
               iyy="${m*(3.0*r*r+h*h)/12.0}" iyz="0.0"
               izz="${m*r*r/2.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="m r">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${2.0*m*r*r/5.0}" ixy="0.0" ixz="0.0"
               iyy="${2.0*m*r*r/5.0}" iyz="0.0"
               izz="${2.0*m*r*r/5.0}"/>
    </inertial>
  </xacro:macro>

  <!-- ==================================================================== -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${base_height/2.0}" rpy="0 0 0"/>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
      <material name="amr_grey"><color rgba="0.35 0.38 0.42 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_height/2.0}" rpy="0 0 0"/>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
    </collision>
    <xacro:box_inertia m="${base_mass}" x="${base_length}" y="${base_width}" z="${base_height}"/>
  </link>

  <!-- Drive wheels -->
  <xacro:macro name="drive_wheel" params="prefix reflect">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="amr_black"><color rgba="0.1 0.1 0.1 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="0 ${reflect * wheel_separation / 2.0} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <!-- 25 Nm, the Classic plugin's max_wheel_torque. Torque to accelerate
           65 kg at 1.0 m/s^2 is 32.5 N per wheel, or 3.25 Nm at a 0.10 m
           radius, so this leaves ample margin for a ramp or a floor seam.
           gz-sim's DiffDrive commands wheel velocity and DART holds it with at
           most this effort, so the limit lives on the joint now. velocity is
           required by the URDF schema; 30 rad/s (3 m/s) is never reached. -->
      <limit effort="25.0" velocity="30.0"/>
      <dynamics damping="0.05" friction="0.1"/>
    </joint>

    <gazebo reference="${prefix}_wheel_link">
      <!-- High friction along the rolling direction, lower across it. Setting
           both high makes the base resist yaw and understeer; setting both low
           makes it slip constantly. -->
      <mu1>1.0</mu1>
      <mu2>0.8</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
    </gazebo>
  </xacro:macro>

  <xacro:drive_wheel prefix="left"  reflect="1"/>
  <xacro:drive_wheel prefix="right" reflect="-1"/>

  <!-- Casters. Modelled as low-friction spheres, which is the standard way to
       avoid simulating a swivel joint that adds nothing but instability. -->
  <xacro:macro name="caster" params="prefix x">
    <link name="${prefix}_caster_link">
      <visual>
        <geometry><sphere radius="${caster_radius}"/></geometry>
        <material name="amr_black"><color rgba="0.1 0.1 0.1 1.0"/></material>
      </visual>
      <collision><geometry><sphere radius="${caster_radius}"/></geometry></collision>
      <xacro:sphere_inertia m="${caster_mass}" r="${caster_radius}"/>
    </link>
    <joint name="${prefix}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${prefix}_caster_link"/>
      <origin xyz="${x} 0 ${caster_radius - wheel_radius + caster_clearance}" rpy="0 0 0"/>
    </joint>
    <gazebo reference="${prefix}_caster_link">
      <mu1>0.02</mu1>
      <mu2>0.02</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:caster prefix="front" x="${base_length/2.0 - 0.08}"/>
  <xacro:caster prefix="rear"  x="${-base_length/2.0 + 0.08}"/>

  <!-- ==================================================================== -->
  <!-- Sensors                                                              -->
  <!-- ==================================================================== -->

  <link name="lidar_2d_link">
    <visual>
      <geometry><cylinder radius="0.05" length="0.06"/></geometry>
      <material name="amr_blue"><color rgba="0.15 0.45 0.75 1.0"/></material>
    </visual>
    <collision><geometry><cylinder radius="0.05" length="0.06"/></geometry></collision>
    <xacro:cylinder_inertia m="0.2" r="0.05" h="0.06"/>
  </link>
  <joint name="lidar_2d_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_2d_link"/>
    <origin xyz="${base_length/2.0 - 0.10} 0 ${lidar_2d_height - wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="mast_link">
    <visual>
      <origin xyz="0 0 ${(lidar_3d_height - base_height)/2.0}"/>
      <geometry><cylinder radius="0.03" length="${lidar_3d_height - base_height}"/></geometry>
      <material name="amr_grey"><color rgba="0.35 0.38 0.42 1.0"/></material>
    </visual>
    <xacro:cylinder_inertia m="1.0" r="0.03" h="${lidar_3d_height - base_height}"/>
  </link>
  <joint name="mast_joint" type="fixed">
    <parent link="base_link"/>
    <child link="mast_link"/>
    <origin xyz="-0.15 0 ${base_height - wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="lidar_3d_link">
    <visual>
      <geometry><cylinder radius="0.045" length="0.07"/></geometry>
      <material name="amr_blue"><color rgba="0.15 0.45 0.75 1.0"/></material>
    </visual>
    <collision><geometry><cylinder radius="0.045" length="0.07"/></geometry></collision>
    <xacro:cylinder_inertia m="0.5" r="0.045" h="0.07"/>
  </link>
  <joint name="lidar_3d_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_3d_link"/>
    <origin xyz="-0.15 0 ${lidar_3d_height - wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="imu_link">
    <xacro:box_inertia m="0.05" x="0.02" y="0.02" z="0.01"/>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <!-- Mounted at the base origin, not on the mast. An IMU on a compliant mast
         reads the mast's own oscillation as body acceleration. -->
    <origin xyz="0 0 0.02" rpy="0 0 0"/>
  </joint>

  <xacro:if value="$(arg use_gazebo)">
    <xacro:include filename="$(find amr_description)/urdf/amr.gazebo.xacro"/>
  </xacro:if>

</robot>
